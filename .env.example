# ---- Core ----
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://accuqual:accuqual@localhost:5432/accuqual

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Redis Streams (workflow / event bus) ----
REDIS_URL=redis://localhost:6379

# ---- ElasticSearch ----
ELASTICSEARCH_URL=http://localhost:9200

# ---- File storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=accuqual-files

# ---- AI Engine (LLM Gateway) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000

# ---- Multi-tenancy ----
# There are deliberately no per-tenant env vars here: tenant identity, status,
# and branding live in the `tenants` table (see the Tenant Onboarding Flow
# Spec) and are resolved per-request from the JWT, not from process env —
# every AccuQual instance serves all tenants from these same settings.
