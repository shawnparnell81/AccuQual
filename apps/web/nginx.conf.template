# SNI is the hostname only. $proxy_host keeps a non-default port (api:3000),
# and a colon is not a legal TLS server name.
map $proxy_host $proxy_ssl_host {
  ~^([^:]+) $1;
  default $proxy_host;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Matches the largest multer limit in the API (25 MB). The stock nginx
  # default is 1 MB, which would reject those uploads at the proxy.
  client_max_body_size 25m;

  # nginx's stock /etc/nginx/mime.types (from the base nginx:1.27-alpine
  # image) maps "application/javascript" to "js" only — it has no ".mjs"
  # entry, so any .mjs request (pdfjs-dist's worker build, and any other
  # ES-module-suffixed asset Vite emits) falls through to the default
  # "application/octet-stream". Browsers enforce a strict MIME check on
  # dynamically-imported modules and reject a non-JS content-type outright,
  # which is the real cause of "Setting up fake worker failed: Failed to
  # fetch dynamically imported module" on the Audit Checklist's PDF preview
  # (pdf.js's GlobalWorkerOptions.workerSrc points at the real, correctly-
  # built file — services/api and Vite were never the problem, nginx's MIME
  # table was). A dedicated location block, matched before the SPA fallback
  # below, fixes just this one extension without touching the rest of the
  # MIME table.
  location ~* \.mjs$ {
    default_type application/javascript;
  }

  # Vite fingerprints every built asset filename with a content hash, so an
  # old browser tab can only ever reference an asset that's actually still
  # on disk under that exact name — safe to cache hard and forever.
  location ~* ^/assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # index.html is the one file whose CONTENT changes on every deploy while
  # its URL never does — with no explicit header here nginx's defaults left
  # the browser free to keep serving an old cached copy indefinitely (it
  # references the previous deploy's now-deleted asset filenames, so
  # /assets/index-<hash>.js 404s and the page silently runs stale code).
  # no-cache still lets the browser keep a local copy, it just must
  # revalidate with the server (a cheap 304 when nothing changed) before
  # ever using it.
  location = /index.html {
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # API_UPSTREAM_URL is an origin with no path: http://api:3000 (compose)
  # or https://<api-host> (Render). A variable proxy_pass plus resolver
  # defers DNS until a request arrives, so nginx still boots when that
  # name is not resolvable yet. A literal proxy_pass http://api:3000/
  # looks that name up while loading the config and exits if it fails,
  # which is what happened on Render (there is no host named "api").
  location /api/ {
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM_URL};
    # Browser calls /api/...; this service serves /... .
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream$uri$is_args$args;

    # HTTPS upstreams need SNI and a Host header of their own hostname.
    # $proxy_host is that host as written in the upstream URL (api:3000
    # for compose, the hostname with no port for https://host).
    proxy_ssl_server_name on;
    proxy_ssl_name $proxy_ssl_host;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Cloudflare Access service token. An empty value is not sent
    # (nginx drops a proxy header whose value is the empty string), so
    # compose and a Render service without Access keep working.
    proxy_set_header CF-Access-Client-Id "${CF_ACCESS_CLIENT_ID}";
    proxy_set_header CF-Access-Client-Secret "${CF_ACCESS_CLIENT_SECRET}";
  }
}
