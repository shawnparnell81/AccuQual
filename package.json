{
  "name": "accuqual",
  "version": "0.1.0",
  "private": true,
  "description": "AccuQual - Next-generation Quality Management System",
  "workspaces": [
    "services/*",
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace services/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace services/api",
    "db:migrate": "npm run db:migrate --workspace services/api",
    "db:seed": "npm run db:seed --workspace services/api",
    "local:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build",
    "local:down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "local:db:setup": "node ops/local-db.mjs setup",
    "local:db:migrate": "node ops/local-db.mjs migrate",
    "local:db:status": "node ops/local-db.mjs status"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "vitest": {
      ".": "4.1.11",
      "vite": "6.4.3"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
