    "db:reset-demo-story": "tsx src/db/resetDemoStory.ts",
    "db:backfill-permissions": "tsx src/db/backfillDepartmentPermissions.ts",
    "db:backfill-nav-preferences": "tsx src/db/backfillNavPreferences.ts",
